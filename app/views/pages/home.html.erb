<div class="hero" style="position:relative; text-align:center; color:#fff;">
  <%= image_tag "hero.jpg", alt: "hero", style: "width:100%; height:420px; object-fit:cover;" %>
  <div style="position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);">
    <h1 style="font-size:40px; margin:0;">最高の宿を見つけよう</h1>
    <p style="font-size:18px; margin-top:8px;">こだわりの宿を簡単に検索・予約</p>
    <div style="margin-top:12px;">
      <%= link_to "施設一覧を見る", rooms_path, class: "btn", style: "background:#ff6b6b;color:#fff;padding:10px 16px;border-radius:6px;text-decoration:none;" %>
      <%= link_to "施設検索", search_rooms_path, class: "btn", style: "background:#ff6b6b;color:#fff;padding:10px 16px;border-radius:6px;text-decoration:none;" %>
    </div>
  </div>
</div>

<section style="max-width:1100px;margin:32px auto;">
  <h2 style="margin-bottom:16px;">おすすめの施設</h2>
  <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px;">
    <% @recommended_rooms.each do |room| %>
      <div class="room-card" style="border:1px solid #eee; border-radius:8px; overflow:hidden; background:#fff;">
        <% if room.respond_to?(:image) && room.image.present? %>
          <%= link_to image_tag(room.image, alt: room.name, style: "width:100%; height:140px; object-fit:cover;"), room_path(room) %>
        <% else %>
          <%= link_to image_tag("room_default.jpg", alt: room.name, style: "width:100%; height:140px; object-fit:cover;"), room_path(room) %>
        <% end %>
        <div style="padding:10px;">
          <h3 style="margin:0 0 6px 0; font-size:16px;"><%= link_to room.name, room_path(room), style: "color:#333; text-decoration:none;" %></h3>
          <p style="margin:0; color:#666; font-size:14px;"><%= truncate(room.description.to_s, length: 60) %></p>
        </div>
      </div>
    <% end %>
  </div>
</section>