<%= form_with model: room, local: true, html: { multipart: true } do |f| %>
  <% if room.errors.any? %>
    <div class="errors" style="color:#c00; margin-bottom:12px;">
      <strong><%= pluralize(room.errors.count, "エラー") %>があります：</strong>
      <ul style="margin:6px 0 0 18px;">
        <% room.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "施設名" %><br>
    <%= f.text_field :name, required: true, style: "width:100%;" %>
  </div>

  <div>
    <%= f.label :description, "施設詳細" %><br>
    <%= f.text_area :description, required: true, rows: 6, style: "width:100%;" %>
  </div>

  <div>
    <%= f.label :price, "宿泊料金（/日）" %><br>
    <%= f.number_field :price, required: true, min: 1, style: "width:200px;" %>
  </div>

  <div>
    <%= f.label :address, "住所" %><br>
    <%= f.text_field :address, required: true, style: "width:100%;" %>
  </div>

  <div>
    <%= f.label :image, "施設画像" %><br>
    <%= f.file_field :image %>
  </div>

  <div style="margin-top:12px;">
    <%= f.submit "登録" %>
  </div>
<% end %>