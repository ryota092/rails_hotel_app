<h1><%= @room.name %></h1>

<% if @room.image.attached? %>
  <div style="max-width:800px;">
    <%= image_tag url_for(@room.image), alt: @room.name, style: "width:100%; height:360px; object-fit:cover; border-radius:6px;" %>
  </div>
<% else %>
  <div style="max-width:800px;">
    <%= image_tag 'room_default.jpg', alt: "デフォルト画像", style: "width:100%; height:360px; object-fit:cover; border-radius:6px;" %>
  </div>
<% end %>

<section style="max-width:720px; margin-top:12px;">
  <p><strong>紹介文</strong></p>
  <div style="white-space:pre-wrap;"><%= simple_format(h(@room.description)) %></div>

  <p style="margin-top:12px;"><strong>料金:</strong> ¥<%= number_with_delimiter(@room.price) %> / 日</p>
  <p><strong>住所:</strong> <%= @room.address %></p>

  <%= link_to "予約する", new_reservation_path(room_id: @room.id), class: "btn" %>

  <p style="margin-top:16px;">
    <%= link_to "戻る", :back, class: "btn" %>
  </p>
</section>